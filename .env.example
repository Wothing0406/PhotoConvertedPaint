# API Key for Google Gemini (needed for AI Art Critic & Color Palette Suggestions)
# Create a copy of this file named '.env' and fill in your API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model names (e.g. gemini-2.0-flash-lite, gemini-1.5-flash)
PRIMARY_TEXT_MODEL=gemini-2.0-flash-lite
PRIMARY_VISION_MODEL=gemini-2.0-flash-lite

